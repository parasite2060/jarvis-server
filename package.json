{
  "name": "@parasite2060/jarvis-server",
  "version": "1.2.0",
  "description": "Jarvis Server — TypeScript port of the dream-memory system",
  "author": "TanNT",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint-output \"{src,apps,libs,test}/**/*.ts\" --audit-level=high",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "dotenv -e .env.e2e -- jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:watch": "dotenv -e .env.e2e -- jest --config ./test/jest-e2e.json --watch",
    "test:e2e:cov": "dotenv -e .env.e2e -- jest --config ./test/jest-e2e.json --coverage",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up -d --wait && (bun run test:e2e; EXIT=$?; docker compose -f docker-compose.e2e.yml down -v; exit $EXIT)",
    "e2e:infra:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:infra:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e:logs": "tail -f logs/e2e-test.log",
    "e2e:logs:clean": "rm -f logs/e2e-test*.log && rm -f logs/application.pid",
    "test:ci": "jest --coverage --runInBand --ci --reporters=default --reporters=jest-junit --reporters=github-actions --json --testLocationInResults --outputFile=report/coverage/jest.json --verbose",
    "migration:create": "bun tools/migration.ts create",
    "migration:generate": "bun tools/migration.ts generate",
    "migration:run": "bun tools/migration.ts run",
    "migration:revert": "bun tools/migration.ts revert",
    "prepare": "husky"
  },
  "dependencies": {
    "@keyvhq/core": "^2.1.11",
    "@langchain/core": "~1.1.45",
    "@langchain/openai": "~1.4.5",
    "@nestjs-redis/kit": "^0.13.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.12",
    "@nestjs/cqrs": "^11.0.2",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@temporalio/activity": "~1.17.0",
    "@temporalio/client": "~1.17.0",
    "@temporalio/worker": "~1.17.0",
    "@temporalio/workflow": "~1.17.0",
    "axios": "^1.17.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron-parser": "^5.5.0",
    "deepagents": "~1.10.0",
    "dotenv": "^17.2.3",
    "joi": "^18.0.2",
    "luxon": "~3.7.2",
    "micromatch": "~4.0.8",
    "nestjs-cls": "^6.2.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^6.1.3",
    "rxjs": "^7.2.0",
    "simple-git": "^3.36.0",
    "typeorm": "^0.3.17",
    "yaml": "~2.9.0",
    "zod": "^4.4.3",
    "mongoose": "7.8.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@golevelup/ts-jest": "^3.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.12",
    "@stylistic/eslint-plugin": "^5.2.0",
    "@stylistic/eslint-plugin-ts": "^4.2.0",
    "@temporalio/testing": "~1.17.0",
    "@types/bun": "^1.3.13",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "~3.7.1",
    "@types/micromatch": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.0",
    "eslint-output": "^4.0.2",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "lint-staged": "^15.0.2",
    "pg-mem": "^3.0.5",
    "prettier": "^3.0.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.0",
    "ts-morph": "^27.0.2",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "jest-junit": {
    "outputDirectory": "./report/unit",
    "outputName": "test-report.xml"
  },
  "lint-staged": {
    "{src,apps,libs,test}/**/*.ts": [
      "bun run lint"
    ]
  },
  "overrides": {
    "axios": "^1.15.1",
    "protobufjs": "^7.5.6",
    "fast-uri": "^3.1.1",
    "lodash": "^4.18.0",
    "socket.io-parser": "^4.2.6",
    "multer": "2.1.1",
    "path-to-regexp": "8.4.0"
  }
}
